{
  "hosting": [
    {
      "target": "booking",
      "public": "dist/booking",
      "ignore": ["**/*.map"],
      "cleanUrls": true,
      "rewrites": [
        { "source": "/api/**", "run": { "serviceId": "booking-api", "region": "us-central1" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ] }
      ]
    },
    {
      "target": "status",
      "public": "dist/status",
      "ignore": ["**/*.map"],
      "cleanUrls": true,
      "rewrites": [
        { "source": "/api/**", "run": { "serviceId": "flight-status-api", "region": "us-central1" } },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "**", "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ] }
      ]
    }
  ]
}
